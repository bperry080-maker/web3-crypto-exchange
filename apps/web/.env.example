# Server-only RPC URLs. Never expose these as NEXT_PUBLIC_* variables.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=

# Optional comma-separated contractAddress:SYMBOL:DECIMALS entries.
# Only use independently verified token contracts on the matching network.
ETHEREUM_TOKENS=
BASE_TOKENS=
BNB_TOKENS=

# Kraken read-only balance monitoring. Keep all values server-side.
# Create a Kraken API key with Query Funds permission only; no trading or withdrawal permissions.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Separate long random token required to view Kraken balances through this dashboard.
# Generate locally with: openssl rand -hex 32
KRAKEN_BALANCE_ACCESS_TOKEN=

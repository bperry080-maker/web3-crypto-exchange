# Server-only RPC URLs. Never expose these as NEXT_PUBLIC_* variables.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=

# CoinGecko Pro API key for server-side wallet balance lookups only.
# Keep blank until you have confirmed your plan includes the wallet balances endpoint.
COINGECKO_API_KEY=

# Optional comma-separated contractAddress:SYMBOL:DECIMALS entries.
# Only use independently verified token contracts on the matching network.
ETHEREUM_TOKENS=
BASE_TOKENS=
BNB_TOKENS=

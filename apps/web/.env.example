# Server-only RPC URLs. Never expose these as NEXT_PUBLIC_* variables.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=

# Optional comma-separated contractAddress:SYMBOL:DECIMALS entries.
# Only use independently verified token contracts on the matching network.
ETHEREUM_TOKENS=
BASE_TOKENS=
BNB_TOKENS=

# CoinGecko Demo API key. Configure in the deployment's server environment only.
# Never use NEXT_PUBLIC_COINGECKO_DEMO_API_KEY or commit a real key.
COINGECKO_DEMO_API_KEY=

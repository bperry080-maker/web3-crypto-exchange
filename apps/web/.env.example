# Server-only RPC URLs. Never expose these as NEXT_PUBLIC_* variables.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=

# Optional comma-separated contractAddress:SYMBOL:DECIMALS entries.
# Only use independently verified token contracts on the matching network.
ETHEREUM_TOKENS=
BASE_TOKENS=
BNB_TOKENS=

# CoinGecko and GeckoTerminal use keyless public read-only APIs in this setup.
# No API key or crypto payment is required. Public rate limits may apply.

# Server-only RPC URLs. Never expose these as NEXT_PUBLIC_* variables.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=

# Optional comma-separated contractAddress:SYMBOL:DECIMALS entries.
# Only use independently verified token contracts on the matching network.
ETHEREUM_TOKENS=
BASE_TOKENS=
BNB_TOKENS=

# CoinGecko keys. Prefer Pro when available; configure only in server-side environments.
# Never use NEXT_PUBLIC_ prefixes or commit real keys.
COINGECKO_PRO_API_KEY=
COINGECKO_DEMO_API_KEY=
